# Python
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg-info/
dist/
build/
_matplotlib_cache/

# Data files (large, not version controlled)
*.h5
*.tif
*.npz
*.npy
*.pth
!requirements.txt

# CSV data files
*.csv

# Outputs
# --------------------------------------------------------------------
# Convention (see also results/README.md):
#   outputs/         — local-only throwaway, NEVER committed.
#                      This is the legacy sandbox default.
#   results/         — paper-asset directory; EXPERIMENT result files are
#                      committed (manifest, result_v2.json, validation.md,
#                      history.json, config snapshot, plus *.csv outputs from
#                      analyze_ablation_results.py and archive_validation_results.py).
#                      Model *.pth and other large binary blobs are kept out
#                      of the git repo (cf. *.pth and saved_models/ entries
#                      below) and live on the GPU host with their SHA256
#                      recorded inside each manifest.json.
#   saved_models/    — *.pth checkpoints; NEVER committed.
# --------------------------------------------------------------------
outputs/
saved_models/

# Per-tree exceptions for paper outputs only.
# Keep *.csv blocked globally; explicitly allow paper-grade CSVs under results/ and tables/.
!results/**/*.csv
!tables/**/*.csv

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
~$*
Desktop.ini

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz

# Figures & compiled documents (regenerable, large)
*.png
*.pdf
*.jpg
*.jpeg
*.docx
*.zip

# Archived competition files (excluded from the paper repo)
archive/
